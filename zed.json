{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Adventure",
  "author": "iTerm2-Color-Schemes",
  "themes": [
    {
      "name": "Adventure",
      "appearance": "dark",
      "style": {
        "background": "#040404",
        "editor.background": "#040404",
        "editor.foreground": "#feffff",
        "editor.gutter.background": "#040404",
        "editor.active_line.background": "#0e0e0e",
        "editor.highlighted_line.background": "#171717",
        "editor.line_number": "#777b80",
        "editor.active_line_number": "#feffff",
        "text": "#feffff",
        "text.muted": "#777b80",
        "text.placeholder": "#777b80",
        "ignored": "#685656",
        "border": "#282828",
        "border.variant": "#171717",
        "element.background": "#040404",
        "element.hover": "#171717",
        "element.selected": "#282828",
        "ghost_element.hover": "#171717",
        "ghost_element.selected": "#282828",
        "panel.background": "#040404",
        "surface.background": "#040404",
        "title_bar.background": "#040404",
        "title_bar.inactive_background": "#040404",
        "status_bar.background": "#040404",
        "toolbar.background": "#040404",
        "tab_bar.background": "#040404",
        "tab.active_background": "#0e0e0e",
        "tab.inactive_background": "#040404",
        "editor.subheader.background": "#040404",
        "elevated_surface.background": "#0e0e0e",
        "drop_target.background": "#5da60233",
        "scrollbar.track.background": "#040404",
        "scrollbar.track.border": "#171717",
        "scrollbar.thumb.background": "#777b8066",
        "terminal.background": "#040404",
        "terminal.ansi.background": "#040404",
        "terminal.foreground": "#feffff",
        "terminal.dim_foreground": "#777b80",
        "terminal.bright_foreground": "#ffffff",
        "terminal.ansi.black": "#040404",
        "terminal.ansi.red": "#d84a33",
        "terminal.ansi.green": "#5da602",
        "terminal.ansi.yellow": "#eebb6e",
        "terminal.ansi.blue": "#417ab3",
        "terminal.ansi.magenta": "#e5c499",
        "terminal.ansi.cyan": "#bdcfe5",
        "terminal.ansi.white": "#dbded8",
        "terminal.ansi.bright_black": "#685656",
        "terminal.ansi.bright_red": "#d76b42",
        "terminal.ansi.bright_green": "#99b52c",
        "terminal.ansi.bright_yellow": "#ffb670",
        "terminal.ansi.bright_blue": "#97d7ef",
        "terminal.ansi.bright_magenta": "#aa7900",
        "terminal.ansi.bright_cyan": "#bdcfe5",
        "terminal.ansi.bright_white": "#e4d5c7",
        "created": "#5da602",
        "deleted": "#d84a33",
        "error": "#d84a33",
        "info": "#417ab3",
        "modified": "#eebb6e",
        "success": "#5da602",
        "warning": "#eebb6e",
        "players": [
          {
            "cursor": "#feffff",
            "background": "#5da602",
            "selection": "#294a01"
          }
        ],
        "syntax": {
          "attribute": { "color": "#eebb6e" },
          "boolean": { "color": "#5da602" },
          "comment": { "color": "#777b80", "font_style": "italic" },
          "comment.doc": { "color": "#777b80", "font_style": "italic" },
          "constant": { "color": "#d84a33" },
          "constructor": { "color": "#eebb6e" },
          "function": { "color": "#5da602" },
          "keyword": { "color": "#417ab3" },
          "number": { "color": "#d84a33" },
          "operator": { "color": "#97d7ef" },
          "property": { "color": "#feffff" },
          "string": { "color": "#99b52c" },
          "string.escape": { "color": "#ffb670" },
          "tag": { "color": "#eebb6e" },
          "type": { "color": "#e5c499" },
          "variable.special": { "color": "#d76b42" }
        }
      }
    }
  ]
}
